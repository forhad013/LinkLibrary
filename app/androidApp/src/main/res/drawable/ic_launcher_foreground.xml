<?xml version="1.0" encoding="utf-8"?>
<!-- Crown Bookmark (GRE-50). Drawn on the 120-unit concept grid, scaled 0.6 into the 108dp adaptive canvas (safe zone 21..87dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="18"
        android:translateY="18">
        <!-- Bookmark with crown top -->
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineJoin="round"
            android:pathData="M38,36 L45,22 L53,31 L60,18 L67,31 L75,22 L82,36 L82,100 L60,85 L38,100 Z" />
        <!-- Chain link: scale 0.5 around the bookmark centre, then rotate -45 -->
        <group
            android:scaleX="0.5"
            android:scaleY="0.5"
            android:translateX="30"
            android:translateY="27">
            <group
                android:pivotX="60"
                android:pivotY="66"
                android:rotation="-45">
                <path
                    android:strokeColor="#5B3BB5"
                    android:strokeWidth="11"
                    android:pathData="M36,54 L56,54 A12,12 0 0,1 56,78 L36,78 A12,12 0 0,1 36,54 Z" />
                <path
                    android:strokeColor="#FF8A3D"
                    android:strokeWidth="11"
                    android:pathData="M64,54 L84,54 A12,12 0 0,1 84,78 L64,78 A12,12 0 0,1 64,54 Z" />
            </group>
        </group>
    </group>
</vector>
