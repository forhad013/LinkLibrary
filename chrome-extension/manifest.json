{
  "manifest_version": 3,
  "name": "LinkLibrary Quick Save",
  "version": "1.0.0",
  "description": "Save links to your LinkLibrary with one click",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:8080/*",
      "https://*.linklibrary.app/*",
      "https://*.vercel.app/*",
      "https://*.firebaseapp.com/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}