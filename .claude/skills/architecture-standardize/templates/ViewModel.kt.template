package {{PACKAGE}}

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import app.cash.molecule.RecompositionMode
import app.cash.molecule.moleculeFlow
import {{REPOSITORY_PACKAGE}}
import kotlinx.coroutines.flow.MutableSharedFlow
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.stateIn
import kotlinx.coroutines.launch
import org.koin.core.component.KoinComponent
import org.koin.core.component.inject

/**
 * ViewModel for {{FEATURE_NAME}} screen.
 *
 * This ViewModel bridges the UI (Screen) and business logic (UseCase).
 * It uses Molecule to create a state machine from the UseCase composable.
 *
 * Architecture:
 * - Extends: ViewModel() for lifecycle management
 * - Implements: KoinComponent for dependency injection
 * - Uses: moleculeFlow() to run UseCase as state machine
 * - Provides: StateFlow for reactive state observation
 * - Handles: Event emission from UI layer
 *
 * Lifecycle:
 * - Created by Screen with viewModel() factory
 * - Survives configuration changes
 * - Cleared when screen is finished
 *
 * @param {{INITIAL_PARAM}} Optional initial parameter from navigation
 */
class {{VIEWMODEL_CLASS_NAME}}(
    private val {{INITIAL_PARAM}}: {{INITIAL_PARAM_TYPE}}? = null
) : ViewModel(), KoinComponent {

    // Initial state - used for stateIn() default value
    private val initialState: {{STATE_CLASS_NAME}} = {{STATE_INITIALIZER}}

    // Event flow - receives events from UI layer
    private val eventsFlow: MutableSharedFlow<{{EVENT_CLASS_NAME}}> =
        MutableSharedFlow(extraBufferCapacity = {{EVENT_BUFFER_SIZE}})

    // Dependency injection via Koin
    private val {{REPOSITORY_NAME}}: {{REPOSITORY_TYPE}} by inject()

    /**
     * StateFlow representing the screen state.
     * Created using Molecule to run UseCase as a state machine.
     *
     * The flow:
     * 1. Runs UseCase with moleculeFlow (RecompositionMode.Immediate)
     * 2. Converts to StateFlow with stateIn
     * 3. Starts lazily when first collected
     * 4. Shares state across multiple collectors
     * 5. Cancellable when ViewModel is cleared
     */
    val states by lazy {
        moleculeFlow(RecompositionMode.Immediate) {
            {{USECASE_FUNCTION_NAME}}(
                initialState = initialState,
                events = eventsFlow,
                {{USECASE_PARAMS}}{{REPOSITORY_NAME}}
            )
        }.stateIn(
            scope = viewModelScope,
            started = SharingStarted.Lazily,
            initialValue = initialState
        )
    }

    // ============================================================================
    // EVENT EMITTERS
    // ============================================================================

    /**
     * Emit events to the UseCase.
     * These methods are called by the Screen layer.
     */

    {{EVENT_EMITTERS}}

    // Generic event emitter for events without specific methods
    fun onEvent(event: {{EVENT_CLASS_NAME}}) {
        viewModelScope.launch { eventsFlow.emit(event) }
    }
}

