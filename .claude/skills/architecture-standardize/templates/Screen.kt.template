package {{PACKAGE}}

import androidx.compose.runtime.Composable
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.collectAsState
import androidx.compose.runtime.getValue
import androidx.lifecycle.viewmodel.compose.viewModel
import androidx.navigation3.runtime.NavKey

/**
 * Screen composable for {{FEATURE_NAME}}.
 *
 * This is the UI layer that:
 * - Creates ViewModel using viewModel() factory
 * - Collects state via collectAsState()
 * - Emits events to ViewModel
 * - Handles navigation callbacks
 *
 * Architecture:
 * - Receives: NavKey for navigation, callback lambdas
 * - Creates: ViewModel with unique key per instance
 * - Collects: State as State for recomposition
 * - Delegates: UI rendering to separate View composable
 *
 * @param routeKey Unique navigation key for this screen instance
 * @param {{NAVIGATION_PARAMS}} Navigation callback parameters
 */
@Composable
fun {{SCREEN_FUNCTION_NAME}}(
    routeKey: NavKey,
    {{NAVIGATION_PARAMS}}
) {
    // Create ViewModel with unique key per navigation instance
    val viewModel: {{VIEWMODEL_CLASS_NAME}} = viewModel<{{VIEWMODEL_CLASS_NAME}}>(
        key = routeKey.toString()
    ) {
        {{VIEWMODEL_FACTORY}}
    }

    // Collect state as Compose State
    val state by viewModel.states.collectAsState()

    // Delegate to separate View composable for cleaner architecture
    {{VIEW_FUNCTION_NAME}}(
        state = state,
        {{VIEW_PARAMS}}
    )
}

