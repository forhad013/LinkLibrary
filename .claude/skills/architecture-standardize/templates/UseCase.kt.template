 *
 * Architecture:
 * - Receives: Initial state, events flow, dependencies (repositories)
 * - Manages: State updates via remember { mutableStateOf() }
 * - Returns: Current state for UI rendering
 *
 * @param initialState The initial state (typically from ViewModel)
 * @param events Flow of events from the UI layer
 * @param {{REPOSITORY_NAME}} Repository for data operations
 * @return Current state for UI rendering
 */
@Composable
fun {{USECASE_FUNCTION_NAME}}(
    initialState: {{STATE_CLASS_NAME}},
    events: Flow<{{EVENT_CLASS_NAME}}>,
    {{REPOSITORY_NAME}}: {{REPOSITORY_TYPE}}
): {{STATE_CLASS_NAME}} {

    // State management with Compose
    var {{STATE_VARIABLE_NAME}} by remember { mutableStateOf(initialState) }

    // INITIAL DATA LOADING
    // Use LaunchedEffect(Unit) for one-time setup
    LaunchedEffect(Unit) {
        {{STATE_VARIABLE_NAME}} = {{STATE_VARIABLE_NAME}}.copy(isLoading = true)
        {{REPOSITORY_NAME}}.{{GET_DATA_METHOD}}().collect { result ->
            {{STATE_VARIABLE_NAME}} = {{STATE_VARIABLE_NAME}}.copy(isLoading = false)
