                    {{DATA_FIELD}} = data.{{TRANSFORM_FUNCTION}}(),
                    error = null
                )
            }
            result.onFailure { error ->
                {{STATE_VARIABLE_NAME}} = {{STATE_VARIABLE_NAME}}.copy(
                    error = error.message
                )
            }
        }
    }

    // EVENT HANDLING
    // Collect and process all user events
    LaunchedEffect(Unit) {
        events.collect { event ->
